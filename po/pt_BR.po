#: data/io.github.jonnsl.Aperture.desktop.in.in:3
#: data/io.github.jonnsl.Aperture.metainfo.xml.in.in:7
msgid "Keep track of your movies and TV shows"
msgstr "Acompanhe seus filmes e séries"

#. Translators: Search terms to find this application. Do NOT translate or localize the semicolons! The list MUST also end with a semicolon!
#: data/io.github.jonnsl.Aperture.desktop.in.in:10
msgid "movie;film;tv;series;show;episode;watchlist;tracker;"
msgstr "movie;film;tv;series;show;episode;watchlist;tracker;filme;série;seriado;episódio;lista;assistir;"

#: data/io.github.jonnsl.Aperture.metainfo.xml.in.in:9
msgid ""
"Aperture lets you build a watchlist of movies and TV shows, keep track of "
"what you have watched, and find out about the latest releases."
msgstr ""
"O Aperture permite montar uma lista de filmes e séries para assistir, "
"acompanhar o que você já assistiu e ficar por dentro dos últimos lançamentos."

#: data/io.github.jonnsl.Aperture.metainfo.xml.in.in:10
msgid ""
"Aperture does not let you watch or download content. This app uses the TMDB "
"API but is not endorsed or certified by TMDB."
msgstr ""
"O Aperture não permite assistir nem baixar conteúdo. Este aplicativo usa a "
"API do TMDB, mas não é endossado nem certificado pelo TMDB."

