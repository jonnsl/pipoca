using Gtk 4.0;
using Adw 1;

Adw.ShortcutsDialog shortcuts_dialog {
  Adw.ShortcutsSection {
    title: _("General");

    Adw.ShortcutsItem {
      title: _("Add Title");
      action-name: "win.search";
    }

    Adw.ShortcutsItem {
      title: _("Filter Library");
      action-name: "win.filter";
    }

    Adw.ShortcutsItem {
      title: _("Refresh");
      action-name: "win.refresh";
    }

    Adw.ShortcutsItem {
      title: _("Preferences");
      action-name: "app.preferences";
    }

    Adw.ShortcutsItem {
      title: _("Keyboard Shortcuts");
      action-name: "app.shortcuts";
    }

    Adw.ShortcutsItem {
      title: _("Quit");
      action-name: "app.quit";
    }
  }

  Adw.ShortcutsSection {
    title: _("Navigation");

    Adw.ShortcutsItem {
      title: _("Watchlist");
      accelerator: "<primary>1";
    }

    Adw.ShortcutsItem {
      title: _("Upcoming");
      accelerator: "<primary>2";
    }

    Adw.ShortcutsItem {
      title: _("Watched");
      accelerator: "<primary>3";
    }

    Adw.ShortcutsItem {
      title: _("Dropped");
      accelerator: "<primary>4";
    }

    Adw.ShortcutsItem {
      title: _("Go Back");
      accelerator: "<alt>Left Escape";
    }
  }
}
