using Gtk 4.0;
using Adw 1;

template $ApertureDiscoverListPage: Adw.NavigationPage {
  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {}

    content: Stack stack {
      transition-type: crossfade;

      StackPage {
        name: "loading";

        child: Adw.Spinner {
          halign: center;
          valign: center;
          width-request: 32;
          height-request: 32;
        };
      }

      StackPage {
        name: "error";

        child: Adw.StatusPage error_page {
          icon-name: "network-offline-symbolic";
          title: _("Can’t Load List");

          child: Button {
            label: _("_Retry");
            use-underline: true;
            halign: center;
            clicked => $on_retry_clicked();

            styles [
              "pill",
            ]
          };
        };
      }

      StackPage {
        name: "content";

        child: ScrolledWindow scroller {
          hscrollbar-policy: never;

          child: Adw.Clamp {
            maximum-size: 1600;
            tightening-threshold: 1600;

            child: Box {
              orientation: vertical;
              spacing: 12;
              margin-top: 12;
              margin-bottom: 24;
              margin-start: 12;
              margin-end: 12;

              FlowBox grid {
                selection-mode: none;
                activate-on-single-click: true;
                homogeneous: true;
                min-children-per-line: 2;
                max-children-per-line: 20;
                row-spacing: 18;
                column-spacing: 12;
                valign: start;
                child-activated => $on_child_activated();
              }

              Adw.Spinner more_spinner {
                halign: center;
                width-request: 32;
                height-request: 32;
                visible: false;
              }
            };
          };
        };
      }
    };
  };
}
