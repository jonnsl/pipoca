using Gtk 4.0;
using Adw 1;

template $PipocaLibraryView: Adw.Bin {
  child: Stack stack {
    transition-type: crossfade;

    StackPage {
      name: "content";

      child: ScrolledWindow {
        hscrollbar-policy: never;

        child: Adw.Clamp {
          maximum-size: 1600;
          tightening-threshold: 1600;

          child: Box sections_box {
            orientation: vertical;
            spacing: 24;
            margin-top: 12;
            margin-bottom: 24;
            margin-start: 12;
            margin-end: 12;
          };
        };
      };
    }

    StackPage {
      name: "empty";

      child: Adw.StatusPage empty_page {
        vexpand: true;

        styles [
          "compact",
        ]
      };
    }

    StackPage {
      name: "no-results";

      child: Adw.StatusPage {
        icon-name: "edit-find-symbolic";
        title: _("No Results Found");
        description: _("Try a different search or filter");
        vexpand: true;

        styles [
          "compact",
        ]
      };
    }
  };
}
