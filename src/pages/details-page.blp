using Gtk 4.0;
using Adw 1;

template $ApertureDetailsPage: Adw.NavigationPage {
  child: Adw.BreakpointBin {
    width-request: 360;
    height-request: 294;

    Adw.Breakpoint {
      condition ("max-width: 600sp")

      setters {
        header_box.orientation: vertical;
        header_box.spacing: 18;
        poster.halign: center;
        title_label.xalign: 0.5;
        title_label.justify: center;
        meta_label.xalign: 0.5;
        meta_label.justify: center;
        network_label.xalign: 0.5;
        network_label.justify: center;
        buttons_box.orientation: vertical;
        buttons_box.halign: fill;
      }
    }

    child: Adw.ToolbarView {
      extend-content-to-top-edge: true;

      [top]
      Adw.HeaderBar {
        show-title: false;

        [end]
        MenuButton {
          icon-name: "view-more-symbolic";
          tooltip-text: _("More Options");
          menu-model: details_menu;
        }
      }

      content: Stack stack {
        transition-type: crossfade;

        StackPage {
          name: "loading";

          child: Adw.Spinner {
            halign: center;
            valign: center;
            width-request: 32;
            height-request: 32;
          };
        }

        StackPage {
          name: "error";

          child: Adw.StatusPage error_page {
            icon-name: "network-offline-symbolic";
            title: _("Can’t Load Details");

            child: Button {
              label: _("_Retry");
              use-underline: true;
              halign: center;
              clicked => $on_retry_clicked();

              styles [
                "pill",
              ]
            };
          };
        }

        StackPage {
          name: "content";

          child: ScrolledWindow {
            hscrollbar-policy: never;

            child: Overlay top_overlay {
              child: Overlay {
                valign: start;

                child: $AperturePoster backdrop {
                  size: "w1280";
                  image-width: -1;
                  image-height: 320;
                  icon-name: "";

                  styles [
                    "backdrop",
                  ]
                };

                [overlay]
                Box {
                  can-target: false;

                  styles [
                    "backdrop-fade",
                  ]
                }
              };

              [overlay]
              Adw.Clamp content_clamp {
                maximum-size: 900;
                tightening-threshold: 600;

                child: Box {
                  orientation: vertical;
                  spacing: 30;
                  margin-start: 12;
                  margin-end: 12;
                  margin-bottom: 24;

                  Box header_box {
                    spacing: 24;

                    $AperturePoster poster {
                      valign: start;

                      styles [
                        "card",
                      ]
                    }

                    Box {
                      orientation: vertical;
                      spacing: 6;
                      valign: end;
                      hexpand: true;

                      Label title_label {
                        xalign: 0;
                        wrap: true;
                        wrap-mode: word_char;

                        styles [
                          "title-1",
                        ]
                      }

                      Label meta_label {
                        xalign: 0;
                        wrap: true;

                        styles [
                          "dim-label",
                        ]
                      }

                      Label network_label {
                        xalign: 0;
                        wrap: true;

                        styles [
                          "dim-label",
                        ]
                      }

                      Box buttons_box {
                        spacing: 12;
                        margin-top: 12;
                        halign: start;

                        Button primary_button {
                          clicked => $on_primary_clicked();

                          styles [
                            "pill",
                          ]
                        }

                        MenuButton library_button {
                          always-show-arrow: true;

                          child: Adw.ButtonContent library_button_content {
                            icon-name: "object-select-symbolic";
                          };

                          styles [
                            "pill",
                          ]
                        }
                      }
                    }
                  }

                  ListBox next_list {
                    selection-mode: none;

                    styles [
                      "boxed-list",
                    ]

                    Adw.ActionRow next_row {
                      use-markup: false;

                      [suffix]
                      Button next_button {
                        icon-name: "object-select-symbolic";
                        tooltip-text: _("Mark as Watched");
                        valign: center;
                        clicked => $on_next_clicked();

                        styles [
                          "flat",
                          "circular",
                        ]
                      }
                    }
                  }

                  Box overview_box {
                    orientation: vertical;
                    spacing: 12;

                    Label {
                      label: _("Overview");
                      xalign: 0;

                      styles [
                        "title-4",
                      ]
                    }

                    Label overview_label {
                      xalign: 0;
                      wrap: true;
                      selectable: true;
                    }
                  }

                  Box seasons_box {
                    orientation: vertical;
                    spacing: 12;

                    Label {
                      label: _("Seasons");
                      xalign: 0;

                      styles [
                        "title-4",
                      ]
                    }

                    ListBox seasons_list {
                      selection-mode: none;
                      row-activated => $on_season_activated();

                      styles [
                        "boxed-list",
                      ]
                    }
                  }

                  Box {
                    orientation: vertical;
                    spacing: 12;

                    Label {
                      label: _("Information");
                      xalign: 0;

                      styles [
                        "title-4",
                      ]
                    }

                    ListBox info_list {
                      selection-mode: none;

                      styles [
                        "boxed-list",
                      ]
                    }
                  }
                };
              }
            };
          };
        }
      };
    };
  };
}

menu details_menu {
  section {
    item {
      label: _("_Refresh Metadata");
      action: "details.refresh";
    }

    item {
      label: _("_Open on TMDB");
      action: "details.open-tmdb";
    }

    item {
      label: _("_Copy Link");
      action: "details.copy-link";
    }
  }
}

