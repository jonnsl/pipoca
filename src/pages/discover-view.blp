using Gtk 4.0;
using Adw 1;

template $PipocaDiscoverView: Adw.Bin {
  child: Stack stack {
    transition-type: crossfade;

    StackPage {
      name: "content";

      child: ScrolledWindow {
        hscrollbar-policy: never;

        child: Adw.Clamp {
          maximum-size: 1600;
          tightening-threshold: 1600;

          child: Box shelves_box {
            orientation: vertical;
            spacing: 24;
            margin-top: 12;
            margin-bottom: 24;
            margin-start: 6;
            margin-end: 6;
          };
        };
      };
    }

    StackPage {
      name: "offline";

      child: Adw.StatusPage offline_page {
        icon-name: "network-offline-symbolic";
        title: _("You’re Offline");
        description: _("Connect to the internet to discover movies and shows");
        vexpand: true;

        child: Button {
          label: _("_Retry");
          use-underline: true;
          halign: center;
          clicked => $on_retry_clicked();

          styles [
            "pill",
          ]
        };

        styles [
          "compact",
        ]
      };
    }
  };
}
