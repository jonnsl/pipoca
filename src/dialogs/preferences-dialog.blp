using Gtk 4.0;
using Adw 1;

template $AperturePreferencesDialog: Adw.PreferencesDialog {
  Adw.PreferencesPage {
    title: _("General");
    icon-name: "preferences-system-symbolic";

    Adw.PreferencesGroup {
      title: _("Updates");

      Adw.SwitchRow refresh_row {
        title: _("Refresh Library Automatically");
        subtitle: _("Update titles from TMDB at startup, at most once a day");
      }
    }

    Adw.PreferencesGroup {
      title: _("Kodi");
      description: _("Import movies, shows and watch history from Kodi’s library. Aperture only reads from Kodi and never changes anything there.");

      Adw.SwitchRow kodi_enabled_row {
        title: _("Sync Automatically");
      }

      Adw.ComboRow kodi_interval_row {
        title: _("Sync Every");
        sensitive: bind kodi_enabled_row.active;

        model: StringList {
          strings [
            _("15 Minutes"),
            _("Hour"),
            _("6 Hours"),
            _("Day"),
          ]
        };
      }

      Adw.EntryRow kodi_address_row {
        title: _("Address");
        input-purpose: url;
        tooltip-text: _("Kodi’s web server, e.g. http://192.168.1.10:8080");
      }

      Adw.EntryRow kodi_username_row {
        title: _("Username");
      }

      Adw.PasswordEntryRow kodi_password_row {
        title: _("Password");
        show-apply-button: true;
        apply => $on_kodi_password_apply();
      }

      Adw.ActionRow kodi_status_row {
        title: _("Last Sync");

        [suffix]
        Adw.Spinner kodi_spinner {
          visible: false;
        }

        [suffix]
        Button kodi_sync_button {
          label: _("Sync _Now");
          use-underline: true;
          valign: center;
          clicked => $on_kodi_sync_clicked();
        }
      }
    }
  }

  Adw.PreferencesPage {
    title: _("Advanced");
    icon-name: "applications-engineering-symbolic";

    Adw.PreferencesGroup {
      title: _("TMDB");
      description: _("Aperture comes with an API key. You can use your own key or read access token instead.");

      Adw.SwitchRow custom_key_row {
        title: _("Use Custom API Key");
      }

      Adw.PasswordEntryRow api_key_row {
        title: _("API Key");
        sensitive: bind custom_key_row.active;
      }
    }

    Adw.PreferencesGroup {
      title: _("Storage");

      Adw.ActionRow cache_row {
        title: _("Image Cache");

        [suffix]
        Button {
          label: _("_Clear");
          use-underline: true;
          valign: center;
          clicked => $on_clear_cache_clicked();
        }
      }
    }

    Adw.PreferencesGroup {
      title: _("Library");
      description: _("Library files keep your titles and watch history. Importing adds to your library without removing anything.");

      Adw.ButtonRow {
        title: _("_Export Library…");
        use-underline: true;
        start-icon-name: "document-save-symbolic";
        activated => $on_export_activated();
      }

      Adw.ButtonRow {
        title: _("_Import Library…");
        use-underline: true;
        start-icon-name: "document-open-symbolic";
        activated => $on_import_activated();
      }
    }
  }
}
