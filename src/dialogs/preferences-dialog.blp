using Gtk 4.0;
using Adw 1;

template $PipocaPreferencesDialog: Adw.PreferencesDialog {
  Adw.PreferencesPage {
    title: _("General");
    icon-name: "preferences-system-symbolic";

    Adw.PreferencesGroup {
      title: _("Content");

      Adw.ComboRow language_row {
        title: _("Metadata Language");
        subtitle: _("Language of titles, overviews and episode names");
        enable-search: true;
      }
    }

    Adw.PreferencesGroup {
      title: _("Spoilers");

      Adw.SwitchRow spoilers_row {
        title: _("Hide Spoilers");
        subtitle: _("Of episodes you haven’t watched yet");
      }

      Adw.ComboRow spoiler_level_row {
        title: _("Hide");
        sensitive: bind spoilers_row.active;

        model: StringList {
          strings [
            _("Thumbnails"),
            _("Thumbnails, Titles and Descriptions"),
          ]
        };
      }
    }

    Adw.PreferencesGroup {
      title: _("Updates");

      Adw.SwitchRow refresh_row {
        title: _("Refresh Library Automatically");
        subtitle: _("Update titles from TMDB at startup, at most once a day");
      }
    }

    Adw.PreferencesGroup {
      title: _("Notifications");
      description: _("Titles can be left out with Notify Me on their page");

      Adw.SwitchRow notify_episodes_row {
        title: _("New Episodes");
        subtitle: _("When an episode of a show in your library airs");
      }

      Adw.SwitchRow notify_movies_row {
        title: _("Movie Releases");
        subtitle: _("When a movie on your watchlist is released");
      }

      Adw.SwitchRow background_row {
        title: _("Run in Background");
        subtitle: _("Keep checking for new releases when the window is closed, and start at login");
      }
    }

  }

  Adw.PreferencesPage {
    title: _("Integrations");
    icon-name: "network-server-symbolic";

    Adw.PreferencesGroup {
      title: _("Kodi");
      description: _("Import movies, shows and watch history from Kodi’s library. Pipoca only reads from Kodi and never changes anything there.");

      Adw.SwitchRow kodi_enabled_row {
        title: _("Sync Automatically");
      }

      Adw.ComboRow kodi_interval_row {
        title: _("Sync Every");
        sensitive: bind kodi_enabled_row.active;

        model: StringList {
          strings [
            _("15 Minutes"),
            _("Hour"),
            _("6 Hours"),
            _("Day"),
          ]
        };
      }

      Adw.EntryRow kodi_address_row {
        title: _("Address");
        input-purpose: url;
        tooltip-text: _("Kodi’s web server, e.g. http://192.168.1.10:8080");
      }

      Adw.EntryRow kodi_username_row {
        title: _("Username");
      }

      Adw.PasswordEntryRow kodi_password_row {
        title: _("Password");
        show-apply-button: true;
        apply => $on_kodi_password_apply();
      }

      Adw.ActionRow kodi_status_row {
        title: _("Last Sync");

        [suffix]
        Adw.Spinner kodi_spinner {
          visible: false;
        }

        [suffix]
        Button kodi_sync_button {
          label: _("Sync _Now");
          use-underline: true;
          valign: center;
          clicked => $on_kodi_sync_clicked();
        }
      }
    }

    $PipocaArrPreferencesGroup radarr_group {}

    $PipocaArrPreferencesGroup sonarr_group {}
  }

  Adw.PreferencesPage {
    title: _("Advanced");
    icon-name: "applications-engineering-symbolic";

    Adw.PreferencesGroup {
      title: _("TMDB");
      description: _("Pipoca comes with an API key. You can use your own key or read access token instead.");

      Adw.SwitchRow custom_key_row {
        title: _("Use Custom API Key");
      }

      Adw.PasswordEntryRow api_key_row {
        title: _("API Key");
        sensitive: bind custom_key_row.active;
      }
    }

    Adw.PreferencesGroup {
      title: _("Storage");

      Adw.ActionRow cache_row {
        title: _("Image Cache");

        [suffix]
        Button {
          label: _("_Clear");
          use-underline: true;
          valign: center;
          clicked => $on_clear_cache_clicked();
        }
      }
    }

    Adw.PreferencesGroup {
      title: _("Library");
      description: _("Library files keep your titles and watch history. Importing adds to your library without removing anything.");

      Adw.ButtonRow {
        title: _("_Export Library…");
        use-underline: true;
        start-icon-name: "document-save-symbolic";
        activated => $on_export_activated();
      }

      Adw.ButtonRow {
        title: _("_Import Library…");
        use-underline: true;
        start-icon-name: "document-open-symbolic";
        activated => $on_import_activated();
      }

      Adw.ButtonRow imdb_row {
        title: _("Import from I_MDb…");
        use-underline: true;
        start-icon-name: "document-open-symbolic";
        tooltip-text: _("Import a ratings or list export from IMDb");
        activated => $on_imdb_activated();
      }
    }
  }
}
