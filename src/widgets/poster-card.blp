using Gtk 4.0;

template $PipocaPosterCard: Box {
  orientation: vertical;
  spacing: 6;
  halign: center;
  valign: start;

  Overlay {
    halign: center;

    child: $PipocaPoster poster {
      styles [
        "card",
      ]
    };

    [overlay]
    Image library_emblem {
      icon-name: "object-select-symbolic";
      tooltip-text: _("In Library");
      halign: start;
      valign: start;
      margin-top: 8;
      margin-start: 8;
      visible: false;

      styles [
        "library-emblem",
      ]
    }

    [overlay]
    Label new_badge {
      label: C_("badge", "New");
      halign: end;
      valign: start;
      margin-top: 8;
      margin-end: 8;
      visible: false;

      styles [
        "new-badge",
        "caption-heading",
      ]
    }

    [overlay]
    ProgressBar progress_bar {
      valign: end;
      margin-start: 8;
      margin-end: 8;
      margin-bottom: 8;
      visible: false;

      styles [
        "osd",
      ]
    }
  }

  Label title_label {
    xalign: 0;
    ellipsize: end;
    max-width-chars: 1;
    hexpand: true;

    styles [
      "heading",
    ]
  }

  Label subtitle_label {
    xalign: 0;
    ellipsize: end;
    max-width-chars: 1;

    styles [
      "caption",
      "dim-label",
    ]
  }
}
