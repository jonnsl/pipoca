using Gtk 4.0;

template $PipocaEpisodeRow: ListBoxRow {
  activatable: true;

  child: Box {
    spacing: 12;
    margin-top: 12;
    margin-bottom: 12;
    margin-start: 12;
    margin-end: 12;

    Overlay {
      valign: start;

      child: $PipocaPoster still {
        size: "w300";
        image-width: 120;
        image-height: 68;
        icon-name: "video-x-generic-symbolic";

        styles [
          "still",
        ]
      };

      [overlay]
      Button reveal_button {
        icon-name: "view-reveal-symbolic";
        halign: center;
        valign: center;
        visible: false;
        tooltip-text: _("Reveal Spoilers");
        clicked => $on_reveal_clicked();

        accessibility {
          label: _("Reveal Spoilers");
        }

        styles [
          "osd",
          "circular",
        ]
      }
    }

    Box {
      orientation: vertical;
      spacing: 3;
      hexpand: true;

      Label title_label {
        xalign: 0;
        wrap: true;
        wrap-mode: word_char;

        styles [
          "heading",
        ]
      }

      Label meta_label {
        xalign: 0;

        styles [
          "caption",
          "dim-label",
        ]
      }

      Label overview_label {
        xalign: 0;
        wrap: true;
        ellipsize: end;
        lines: 2;
        margin-top: 3;
      }
    }

    ToggleButton watched_button {
      icon-name: "object-select-symbolic";
      valign: center;
      tooltip-text: _("Mark as Watched");

      styles [
        "flat",
        "circular",
        "watched-toggle",
      ]
    }
  };
}
