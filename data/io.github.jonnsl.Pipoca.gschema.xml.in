<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="pipoca">
  <schema id="@APP_ID@" path="/io/github/jonnsl/Pipoca/">
    <key name="window-width" type="i">
      <default>1000</default>
      <summary>Window width</summary>
    </key>
    <key name="window-height" type="i">
      <default>700</default>
      <summary>Window height</summary>
    </key>
    <key name="window-maximized" type="b">
      <default>false</default>
      <summary>Window maximized state</summary>
    </key>
    <key name="sort-order" type="s">
      <choices>
        <choice value="added"/>
        <choice value="title"/>
        <choice value="release"/>
        <choice value="watched"/>
      </choices>
      <default>'added'</default>
      <summary>Sort order of the library</summary>
    </key>
    <key name="metadata-language" type="s">
      <default>''</default>
      <summary>Language of titles, overviews and episode names</summary>
      <description>A TMDB language tag such as “pt-BR”; empty for the system language</description>
    </key>
    <key name="refresh-automatically" type="b">
      <default>true</default>
      <summary>Refresh stale titles from TMDB at startup</summary>
    </key>
    <key name="last-opened" type="s">
      <default>''</default>
      <summary>Local date (YYYY-MM-DD) the window was last opened</summary>
      <description>Titles with episodes or releases after this date get a “New” badge</description>
    </key>
    <key name="hide-spoilers" type="b">
      <default>false</default>
      <summary>Hide spoilers of unwatched episodes</summary>
    </key>
    <key name="spoiler-level" type="s">
      <choices>
        <choice value="images"/>
        <choice value="details"/>
      </choices>
      <default>'images'</default>
      <summary>What to hide of unwatched episodes</summary>
      <description>“images” blurs their stills; “details” also hides their names and overviews</description>
    </key>
    <key name="notify-new-episodes" type="b">
      <default>true</default>
      <summary>Notify about new episodes</summary>
    </key>
    <key name="notify-movie-releases" type="b">
      <default>true</default>
      <summary>Notify about movie releases</summary>
    </key>
    <key name="notified-until" type="s">
      <default>''</default>
      <summary>Local date (YYYY-MM-DD) of the last check for releases to notify about</summary>
    </key>
    <key name="run-in-background" type="b">
      <default>false</default>
      <summary>Keep running when the window is closed</summary>
      <description>Keep checking for new episodes and releases, and start at login without a window</description>
    </key>
    <key name="use-custom-api-key" type="b">
      <default>false</default>
      <summary>Use a custom TMDB API key</summary>
    </key>
    <key name="custom-api-key" type="s">
      <default>''</default>
      <summary>Custom TMDB API key or read access token</summary>
    </key>
    <key name="kodi-enabled" type="b">
      <default>false</default>
      <summary>Sync from Kodi</summary>
      <description>Import titles and watch history from Kodi periodically</description>
    </key>
    <key name="kodi-address" type="s">
      <default>''</default>
      <summary>Address of Kodi’s web server, e.g. http://192.168.1.10:8080</summary>
    </key>
    <key name="kodi-username" type="s">
      <default>''</default>
      <summary>Username for Kodi’s web server</summary>
    </key>
    <key name="kodi-sync-interval" type="i">
      <range min="5" max="1440"/>
      <default>60</default>
      <summary>Minutes between Kodi syncs</summary>
    </key>
    <key name="kodi-last-sync" type="x">
      <default>0</default>
      <summary>When the last successful Kodi sync finished (Unix time)</summary>
    </key>
    <key name="radarr-enabled" type="b">
      <default>false</default>
      <summary>Sync with Radarr</summary>
      <description>Import movies from Radarr periodically, and add watchlist movies to it unless read-only</description>
    </key>
    <key name="radarr-read-only" type="b">
      <default>true</default>
      <summary>Only import from Radarr</summary>
      <description>Never add movies to Radarr</description>
    </key>
    <key name="radarr-address" type="s">
      <default>''</default>
      <summary>Address of Radarr, e.g. http://192.168.1.10:7878</summary>
    </key>
    <key name="radarr-username" type="s">
      <default>''</default>
      <summary>Username for a web server in front of Radarr</summary>
      <description>For HTTP Basic auth; Radarr itself only needs the API key</description>
    </key>
    <key name="radarr-accept-any-certificate" type="b">
      <default>false</default>
      <summary>Accept untrusted certificates from Radarr</summary>
      <description>For servers with self-signed certificates</description>
    </key>
    <key name="radarr-quality-profile" type="x">
      <default>0</default>
      <summary>Id of the quality profile for movies added to Radarr</summary>
      <description>0, or an id Radarr doesn’t have, uses its first profile</description>
    </key>
    <key name="radarr-root-folder" type="s">
      <default>''</default>
      <summary>Root folder for movies added to Radarr</summary>
      <description>Empty, or a folder Radarr doesn’t have, uses its first one</description>
    </key>
    <key name="radarr-sync-interval" type="i">
      <range min="5" max="1440"/>
      <default>60</default>
      <summary>Minutes between Radarr syncs</summary>
    </key>
    <key name="radarr-last-sync" type="x">
      <default>0</default>
      <summary>When the last successful Radarr sync finished (Unix time)</summary>
    </key>
  </schema>
</schemalist>
